{
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint resources/assets/js/ app/ tests/Unit/Frontend/ jest.setup.js && echo 'No errors, no warnings!'",
    "lint:fix": "eslint resources/assets/js/ app/ tests/Unit/Frontend/ jest.setup.js --fix",
    "lint:tests": "eslint tests/Unit/Frontend/ && echo 'Test files OK'",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "watch-test": "jest --watch --notify"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^2.0.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-dom": "^3.5.40",
    "@vue/compiler-sfc": "^3.5.40",
    "@vue/test-utils": "^2.4.11",
    "@vue/vue3-jest": "^29.2.6",
    "axios-mock-adapter": "^2.1.0",
    "babel-jest": "^29.7.0",
    "bootstrap": "^5.3.8",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "laravel-vite-plugin": "^3.1.3",
    "lodash": "^4.18.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.25",
    "sass": "^1.102.0",
    "undici": "^8.9.0",
    "vite": "^8.2.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "dependencies": {
    "@aacassandra/vue3-progressbar": "^1.0.3",
    "@sentry/vue": "^10.69.0",
    "@tinymce/tinymce-vue": "^6.3.0",
    "@vee-validate/i18n": "^4.15.1",
    "@vee-validate/rules": "^4.15.1",
    "@vueform/toggle": "^2.1.4",
    "axios": "^1.19.0",
    "epic-spinners": "^2.0.0",
    "flag-icons": "^7.5.0",
    "floating-vue": "^5.2.2",
    "intl-tel-input": "^29.1.2",
    "luxon": "^3.7.2",
    "mitt": "^3.0.1",
    "pinia": "^4.0.2",
    "v-tables-3": "^0.4.7",
    "validator": "^13.15.35",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.40",
    "vue-cropperjs": "^5.0.0",
    "vue-datepicker-next": "^1.0.3",
    "vue-loading-overlay": "^6.0.6",
    "vue-router": "^5.2.0",
    "vue-select": "^4.0.0-beta.6",
    "vue3-treeselect": "^0.1.10",
    "yup": "^1.7.1"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "node",
        "node-addons"
      ]
    },
    "transform": {
      ".*\\.(vue)$": "@vue/vue3-jest",
      ".*\\.m?js$": "babel-jest"
    },
    "moduleFileExtensions": [
      "js",
      "json",
      "vue"
    ],
    "moduleNameMapper": {
      "^intl-tel-input/intlTelInputWithUtils$": "intl-tel-input/dist/js/intlTelInputWithUtils.js",
      "^@/(.*)$": "<rootDir>/resources/assets/js/$1",
      "^@recaptcha/(.*)$": "<rootDir>/app/Plugins/Recaptcha/resources/assets/js/vue/$1",
      "\\.(css|less|scss|sass|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot)$": "identity-obj-proxy",
      "^.*Resources/js/Pages/(.*)$": "<rootDir>/app/License/Resources/js/Pages/$1",
      "^.*Resources/js/(.*)$": "<rootDir>/resources/assets/js/$1",
      "^helpers/(.*)$": "<rootDir>/resources/assets/js/helpers/$1"
    },
    "moduleDirectories": [
      "node_modules",
      "resources/assets/js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(@vue|axios|pinia|@pinia|nostics|@vueform)/)"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "roots": [
      "<rootDir>/tests/Unit/Frontend",
      "<rootDir>/app/License/tests/Frontend"
    ],
    "testMatch": [
      "**/?(*.)+(spec).js"
    ],
    "collectCoverageFrom": [
      "resources/assets/js/**/*.{js,vue}",
      "app/License/Resources/js/**/*.{js,vue}",
      "!**/*.spec.js",
      "!**/tests/**",
      "!resources/assets/js/admin.js",
      "!resources/assets/js/client.js"
    ],
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "statements": 86,
        "branches": 64,
        "functions": 48,
        "lines": 86
      }
    },
    "globals": {
      "vue": {
        "config": {
          "isCustomElement": true
        }
      }
    }
  },
  "babel": {
    "presets": [
      [
        "@babel/preset-env",
        {
          "targets": {
            "node": "current"
          }
        }
      ]
    ]
  },
  "jshintConfig": {
    "esversion": 8,
    "browser": true,
    "node": false,
    "module": true,
    "asi": true
  },
  "packageManager": "yarn@4.10.3",
  "resolutions": {
    "tar": "7.5.4"
  }
}
